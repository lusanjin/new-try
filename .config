#
# ==========================================
# 1. 系统内核与编译优化（极限压缩体积）
# ==========================================
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_GC_SECTIONS=y

# ==========================================
# 2. LuCI 基础菜单与基础功能（保障"状态/系统/服务/网络"框架）
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ==========================================
# 3. 基础网络与 WiFi 支持（保障 DHCP、接口、WiFi 正常）
# ==========================================
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_hostapd-common=y

# ==========================================
# 4. 你需要保留的 4 个核心插件
# ==========================================
# 4.1 UPnP（源码自带，会自动引入 miniupnpd）
CONFIG_PACKAGE_luci-app-upnp=y

# 4.2 KMS（源码自带，会自动引入 vlmcsd）
CONFIG_PACKAGE_luci-app-vlmcsd=y

# 4.3 AdGuard Home（第三方源）
CONFIG_PACKAGE_luci-app-adguardhome=y

# 4.4 PassWall（第三方源，极度精简版，仅保留 Xray 核心）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
# 关闭 PassWall 的其他代理核心以省空间：
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Sing-Box is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan-Plus is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set

# ==========================================
# 5. 强制剔除的冗余插件（使用 is not set 格式，确保生效）
# ==========================================
# 冲突的科学上网插件
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-openclash is not set

# 容器与存储
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_autosamba is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set

# 下载工具
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_PACKAGE_luci-app-qbittorrent is not set

# 网络加速与冗余
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-sfe is not set

# IPv6（若无需求）
# CONFIG_PACKAGE_luci-app-ipv6helper is not set

# 远程与穿透
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-zerotier is not set

# 其他小工具
# CONFIG_PACKAGE_luci-app-accesscontrol is not set
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-ddns is not set

# 网络诊断（尝试禁用）
# CONFIG_PACKAGE_luci-app-diag-core is not set
